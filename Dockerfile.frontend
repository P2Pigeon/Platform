# Frontend Dockerfile for P2Pigeon
# Multi-stage build for production
FROM node:20-bullseye-slim AS builder

# Install build tools for native modules
RUN apt-get update && apt-get install -y build-essential python3 && rm -rf /var/lib/apt/lists/*
WORKDIR /build

# Install pnpm with exact version
RUN npm install -g pnpm@10.12.4

# Copy only necessary files for monorepo build
COPY package.json pnpm-workspace.yaml ./
COPY pnpm-lock.yaml ./
COPY tsconfig.base.json ./
COPY frontend/package.json ./frontend/
COPY shared/package.json ./shared/

# Install all workspace dependencies (shared + frontend)
RUN pnpm install --frozen-lockfile

# Copy source for shared and frontend
COPY shared ./shared
COPY frontend ./frontend

# Build frontend
RUN pnpm --filter "@pigeon/frontend" build

# Production image
FROM node:20-bullseye-slim
WORKDIR /app

# Install serve for static file serving and curl for healthcheck
RUN apt-get update && apt-get install -y curl && rm -rf /var/lib/apt/lists/*
RUN npm install -g serve@14.2.1

# Copy built frontend (Vite outputs to dist/)
COPY --from=builder /build/frontend/dist ./dist

# Use non-root user
RUN groupadd -g 1001 pigeon && \
    useradd -u 1001 -g pigeon -s /bin/sh -m pigeon
RUN chown -R pigeon:pigeon /app
USER pigeon

# Health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD curl -f http://localhost:5173/ || exit 1

EXPOSE 5173
CMD ["serve", "-s", "dist", "-l", "5173"]
