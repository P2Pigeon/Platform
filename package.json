{
    "name": "pigeon",
    "version": "0.2.0",
    "private": true,
    "description": "A decentralized communication platform for video, chat, and file transfer.",
    "build": {
        "appId": "com.pigeon.app",
        "files": [
            "app/**/*",
            "frontend/build/**/*",
            "node_modules/**/*",
            "package.json",
            ".env"
        ],
        "directories": {
            "buildResources": "resources"
        },
        "publish": null
    },
    "scripts": {
        "dev": "pnpm --filter \"@pigeon/backend\" build && concurrently \"pnpm:backend-dev\" \"pnpm:frontend-dev\"",
        "backend-dev": "cd app && node --unhandled-rejections=strict dist/src/server.js",
        "frontend-dev": "cd frontend && pnpm dev",
        "build": "pnpm --filter \"@pigeon/backend\" --filter \"@pigeon/frontend\" build",
        "start": "electron .",
        "start:pm2": "pm2 start ecosystem.config.js",
        "start:pm2:prod": "pm2 start ecosystem.config.js --env production",
        "stop:pm2": "pm2 stop ecosystem.config.js",
        "restart:pm2": "pm2 restart ecosystem.config.js",
        "logs:pm2": "pm2 logs pigeon-backend",
        "status:pm2": "pm2 status",
        "monit:pm2": "pm2 monit",
        "electron:build": "tsc --project electron/tsconfig.json",
        "electron:start": "electron .",
        "electron:dev": "ts-node electron/main.ts",
        "lint": "npx prettier --write .",
        "clean": "rimraf node_modules .pnpm-store && pnpm --filter \"@pigeon/backend\" --filter \"@pigeon/frontend\" clean"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/P2Pigeon/pigeon-app"
    },
    "keywords": [
        "webrtc",
        "socket.io",
        "p2p",
        "nodejs",
        "video",
        "nostr",
        "chat"
    ],
    "author": "Pigeon Developers",
    "main": "electron/dist/main.js",
    "license": "AGPL-3.0",
    "overrides": {
        "ajv": "6.12.6"
    },
    "homepage": "https://github.com/P2Pigeon/pigeon-app",
    "dependencies": {
        "@hyperswarm/dht": "^6.5.1",
        "@noble/secp256k1": "^1.7.1",
        "@scure/bip32": "^1.1.3",
        "@sentry/integrations": "^7.86.0",
        "@sentry/node": "^7.86.0",
        "ajv": "6.12.6",
        "axios": "^1.6.2",
        "base58-js": "^1.0.5",
        "buffer": "^6.0.3",
        "colors": "^1.4.0",
        "crypto-js": "^4.2.0",
        "dotenv": "^16.3.1",
        "i18next": "^22.4.9",
        "keypear": "^1.2.0",
        "lodash": "^4.17.21",
        "lodash.chunk": "^4.2.0",
        "lodash.isequal": "^4.5.0",
        "lodash.toarray": "^4.4.0",
        "lodash.uniq": "^4.5.0",
        "lodash.uniqby": "^4.7.0",
        "moment": "^2.29.4",
        "ngrok": "^4.3.3",
        "nostr-tools": "^1.11.1",
        "openai": "^5.7.0",
        "pump": "^3.0.0",
        "qs": "^6.11.2"
    },
    "devDependencies": {
        "@types/lodash.chunk": "^4.2.7",
        "@types/lodash.isequal": "^4.5.6",
        "@types/lodash.toarray": "^4.4.7",
        "@types/lodash.uniq": "^4.5.7",
        "@types/lodash.uniqby": "^4.7.0",
        "concurrently": "^9.2.0",
        "electron": "^39.2.7",
        "node-fetch": "^2.7.0",
        "prettier": "3.0.0",
        "puppeteer": "^24.34.0",
        "typescript": "^5.0.0"
    },
    "eslintConfig": {
        "extends": [
            "react-app",
            "react-app/jest"
        ]
    },
    "browserslist": {
        "production": [
            "last 2 chrome version",
            "last 2 firefox version",
            "last 2 safari version"
        ],
        "development": [
            "last 1 chrome version",
            "last 1 firefox version",
            "last 1 safari version"
        ]
    }
}
